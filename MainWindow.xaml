<Window x:Class="LighterSpotify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LighterSpotify" Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" Foreground="{StaticResource TextMain}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Closing="Window_Closing"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Line}" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <StackPanel Margin="14,12,14,12">

            <!-- Now playing -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ArtBorder" Width="56" Height="56" CornerRadius="6" Background="{StaticResource Surface}">
                    <TextBlock x:Name="ArtPlaceholder" Text="&#xEC4F;" FontFamily="{StaticResource Icons}" FontSize="20"
                               Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistText" Text="" FontSize="12" Foreground="{StaticResource TextSub}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock x:Name="DeviceText" Text="" FontSize="10.5" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="LockButton" Style="{StaticResource IconButton}" Content="&#xE785;" ToolTip="Lock controls" Click="Lock_Click" Visibility="Collapsed"/>
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;" ToolTip="Always on top" Click="Pin_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Hide to tray" Click="Hide_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Quit" Click="Quit_Click"/>
                </StackPanel>
            </Grid>

            <!-- Progress -->
            <Grid x:Name="ProgressRow" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText" Text="0:00" FontSize="10.5" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                <Slider x:Name="ProgressSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" Margin="6,0"/>
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="10.5" Foreground="{StaticResource TextSub}"
                           VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>

            <!-- Controls -->
            <Grid x:Name="ControlsRow" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SearchToggle" Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Search songs" Click="SearchToggle_Click"/>
                    <Button x:Name="PlayHereButton" Style="{StaticResource IconButton}" Content="&#xE7F5;" ToolTip="Play on this PC" Click="PlayHere_Click" Margin="2,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Width="34" Height="34" FontSize="14" ToolTip="Previous" Click="Previous_Click"/>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Content="&#xE768;" Margin="10,0" Click="PlayPause_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Width="34" Height="34" FontSize="14" ToolTip="Next" Click="Next_Click"/>
                </StackPanel>

                <StackPanel x:Name="VolumePanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent">
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource TextSub}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="VolumeSlider" Width="64" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100" Value="50"/>
                </StackPanel>
            </Grid>

            <!-- Login -->
            <StackPanel x:Name="LoginPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="Log in once so this player can control your Spotify." FontSize="12"
                           Foreground="{StaticResource TextSub}" TextWrapping="Wrap"/>
                <Button Style="{StaticResource AccentButton}" Content="Log in with Spotify" HorizontalAlignment="Left"
                        Margin="0,10,0,0" Click="Login_Click"/>
            </StackPanel>

            <!-- Search -->
            <StackPanel x:Name="SearchPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Search songs and press Enter" IsHitTestVisible="False"
                               Foreground="#666666" FontSize="12" Margin="11,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Hidden" Margin="0,8,0,0">
                    <StackPanel>
                        <ItemsControl x:Name="ResultsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource RowButton}" Click="Result_Click" ToolTip="Play">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="4" Background="{StaticResource Surface}" ClipToBounds="True">
                                                    <Image Source="{Binding ImageUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Artists}" FontSize="11" Foreground="{StaticResource TextSub}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Add to queue"
                                                Click="Queue_Click" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="LoadMoreButton" Style="{StaticResource TextButton}" Content="Load more" Visibility="Collapsed"
                                HorizontalAlignment="Center" Margin="0,8,0,2" Click="LoadMore_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <!-- Settings -->
            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock Text="Spotify Client ID" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ClientIdBox" Style="{StaticResource DarkTextBox}"/>

                <TextBlock Text="librespot.exe (leave empty to auto-find)" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LibrespotPathBox" Style="{StaticResource DarkTextBox}"/>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8DA;" ToolTip="Browse" Margin="6,0,0,0" Click="Browse_Click"/>
                </Grid>

                <TextBlock Text="Device name" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DeviceNameBox" Style="{StaticResource DarkTextBox}"/>

                <CheckBox x:Name="MediaKeysCheck" Content="Capture media keys (blocks them in other apps)" Foreground="{StaticResource TextMain}"
                          FontSize="12" Margin="0,12,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="Save" Click="SaveSettings_Click"/>
                    <Button Style="{StaticResource TextButton}" Content="Log out" Margin="8,0,0,0" Click="Logout_Click"/>
                </StackPanel>

                <TextBlock FontSize="10.5" Foreground="{StaticResource TextSub}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="Redirect URI for your Spotify app: http://127.0.0.1:8888/callback"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Visibility="Collapsed" FontSize="10.5" Foreground="#E5A50A" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
